# ============================================
# RAILSENSE AI - Environment Configuration
# ============================================

# ============ CORE APPLICATION ============
ENVIRONMENT=development
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
DEBUG=true

# ============ DATABASE ============
# Development/Local: SQLite (included in docker-compose)
# Production: Use Supabase or AWS RDS PostgreSQL
DATABASE_URL=postgresql+asyncpg://railuser:railpass@db:5432/railsense
SYNC_DATABASE_URL=postgresql://railuser:railpass@db:5432/railsense

# ============ CACHE & MESSAGE QUEUE ============
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============ FRONTEND ============
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ============ EXTERNAL API KEYS ============
# NTES API: Indian Railways Train Status
NTES_API_KEY=your_ntes_api_key_here
NTES_API_URL=https://api.ntes.railway.gov.in
NTES_BRIDGE_URL=http://localhost:3001

# OpenWeather: Weather data for delay prediction
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ============ SMS & NOTIFICATIONS ============
# Twilio: SMS alerts for feature phones
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Alternatively, use MSG91 for India-based SMS
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_API_URL=https://api.msg91.com/api

# ============ FILE STORAGE ============
# Cloudinary: CCTV and track image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Alternatively, use AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=railsense-uploads

# ============ ML MODEL PATHS ============
# Local paths or S3 URLs for pre-trained models
DELAY_MODEL_PATH=./models/delay_xgboost_v1.pkl
YOLOv5_WEIGHTS_PATH=./models/yolov5s.pt
VISION_TRANSFORMER_PATH=./models/vit-base-patch16-224.bin

# ============ AUTHENTICATION ============
# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
JWT_REFRESH_EXPIRY_DAYS=30

# ============ RATE LIMITING ============
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_AUTHENTICATED=500

# ============ LOGGING ============
LOG_LEVEL=INFO
LOG_FILE=./logs/railsense.log

# ============ DEPLOYMENT ============
# Vercel (Frontend)
VERCEL_TOKEN=your_vercel_token_here
VERCEL_PROJECT_ID=your_vercel_project_id

# Render (Backend)
RENDER_API_KEY=your_render_api_key_here
RENDER_SERVICE_ID=your_render_service_id
